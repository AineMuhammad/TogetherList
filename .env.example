# Postgres connection string (Neon / Vercel Marketplace Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Reserved for the planned reminder emails; not used yet
RESEND_API_KEY=""

# Optional: direct (non-pooled) connection for Prisma migrations.
# Defaults to DATABASE_URL with "-pooler" removed from the host.
# DIRECT_URL=""
