generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth.js (NextAuth v5) models ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  memberships  HouseholdMember[]
  groceryItems GroceryItem[]
  recipes      Recipe[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---- TogetherList domain models ----

enum ShoppingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MemberRole {
  OWNER
  MEMBER
}

enum GroceryCategory {
  PRODUCE
  DAIRY
  MEAT
  PANTRY
  FROZEN
  HOUSEHOLD
  OTHER
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

model Household {
  id          String      @id @default(cuid())
  name        String
  joinCode    String      @unique
  shoppingDay ShoppingDay @default(SATURDAY)
  createdAt   DateTime    @default(now())

  members      HouseholdMember[]
  groceryItems GroceryItem[]
  recipes      Recipe[]
  mealPlan     MealPlanEntry[]
}

model HouseholdMember {
  id          String     @id @default(cuid())
  householdId String
  userId      String
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model GroceryItem {
  id          String          @id @default(cuid())
  householdId String
  name        String
  category    GroceryCategory @default(OTHER)
  quantity    String?
  checked     Boolean         @default(false)
  addedById   String?
  createdAt   DateTime        @default(now())
  checkedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([householdId, checked])
}

model Recipe {
  id           String   @id @default(cuid())
  householdId  String
  name         String
  // One free-text line per ingredient, e.g. "2 cups flour"
  ingredients  String[]
  instructions String?
  createdById  String?
  createdAt    DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  mealPlan  MealPlanEntry[]

  @@index([householdId])
}

model MealPlanEntry {
  id          String   @id @default(cuid())
  householdId String
  date        DateTime @db.Date
  mealSlot    MealSlot
  recipeId    String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
}
